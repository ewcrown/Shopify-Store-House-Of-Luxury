{% assign s = section.settings %}
<section class="ew-form-content ew-form-content={{ section.id }}" id="ew-form-content">
  <div class="ew-form-content-row">
    <div class="page-width">
      <div class="ew-form-content-wrap">
        <h3 class="ew-form-heading">{{  s.heading }}</h3>
        {% if s.description != blank %}
          <p class="ew-form-description">{{  s.description }}</p>
        {% endif %}
        <div class="ew-form-content-grid">
          <div class="ew-form-content-image">
            {% if s.single_image %}
            <img src="{{ s.single_image | image_url: width: 1000 }}" class="img-responsive" />
            {% endif %}
            </div>
            <div class="ew-form-content-ghl">
              {% render 'ew-form-snippet', form: s.form_content %}
            </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "<> Form Content",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading Here",
        "default": "Authenticate Your Item"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description Here"
      },
      {
        "type": "image_picker",
        "id": "single_image",
        "label": "Image"
      },
      {
        "type": "liquid",
        "id": "form_content",
        "label": "Form Snippet"
      }
    ],
    "presets": [
      {
        "name": "<> Form Content"
      }
    ]
  }
{% endschema %}