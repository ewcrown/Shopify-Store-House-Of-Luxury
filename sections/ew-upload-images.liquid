{% assign s = section.settings %}
<section class="ew-form-content ew-form-content={{ section.id }}" id="ew-form-content">
  <div class="ew-form-content-row">
    <div class="page-width">
      <div class="ew-form-content-wrap">
        <h3 class="ew-form-heading">{{  s.heading }}</h3>
        <p class="ew-form-description">{{  s.description }}</p>
        <div class="ew-upload-images">
            {% for block in section.blocks %}
              {% if block.settings.logo %}
                <div class="ew-single-image">
                  <img src="{{ block.settings.logo | image_url: width: 500 }}" class="img-responsive" alt="Images" />
                </div>
              {% endif %}
            {% endfor %}
          </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
  {
    "name": "<> Upload Images",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading Here",
        "default": "Upload Image"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description Here",
        "default": "Note: Lorem ipsum dolor sit amet, consectetur adipiscing elit. "
      }
    ],
    "blocks": [
      {
        "type": "logo",
        "name": "Logo",
        "settings": [
          {
            "type": "image_picker",
            "id": "logo",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "<> Upload Images"
      }
    ]
  }
{% endschema %}