{% if customer %}
{% if form != blank %}
  <div class="ew-form-snippet">
    {{ form }}
  </div>
{% endif %}
{% else %}
 <div class="ew-form-non-customer-snippet">
   Please log in to fill out the forms. <a href='/account/login?return_url=%2Fpages%2F{{  request.path | replace: '/pages/', '' }}'>Login</a>
  </div>
{% endif %}